# Normalise every text file to LF so shell scripts, Dockerfiles and Python code
# work unchanged inside Linux containers, even when checked out on Windows.
* text=auto eol=lf

# Explicit LF for files that break with CRLF inside containers
*.sh          text eol=lf
Dockerfile    text eol=lf
*.Dockerfile  text eol=lf
*.py          text eol=lf
*.sql         text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.toml        text eol=lf
.env*         text eol=lf

# PowerShell scripts are Windows-native
*.ps1         text eol=crlf

# Binary files
*.png         binary
*.jpg         binary
*.parquet     binary
*.zip         binary

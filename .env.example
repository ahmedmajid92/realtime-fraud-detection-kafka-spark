# =====================================================================
#  Configuration for every service. Copy to .env (".\run.ps1 setup" does
#  this for you and generates a random POSTGRES_PASSWORD).
#  Values are read by docker-compose.yml and by src/common/config.py.
#  Do not quote values and do not put comments at the end of a line.
# =====================================================================

# ---- Compose ----
COMPOSE_PROJECT_NAME=fraud-detection
TZ=UTC

# ---- Kafka (container-internal address; host tools use localhost:KAFKA_EXTERNAL_HOST_PORT) ----
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CLUSTER_ID=4L6g3nShT-eMCtK--X86sw
KAFKA_EXTERNAL_HOST_PORT=9094
TOPIC_TRANSACTIONS=transactions
TOPIC_PREDICTIONS=predictions
TOPIC_FRAUD_ALERTS=fraud-alerts
TOPIC_PRODUCER_CONTROL=producer-control

# ---- PostgreSQL ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=fraud
POSTGRES_USER=fraud
POSTGRES_PASSWORD=change-me
POSTGRES_HOST_PORT=15432

# ---- Paths inside the containers ----
DATA_DIR=/app/data
MODEL_DIR=/app/models
DOCS_DIR=/app/docs
CHECKPOINT_DIR=/checkpoints
HEARTBEAT_DIR=/tmp

# ---- Training (offline batch) ----
RANDOM_SEED=42
UNDERSAMPLE_RATIO=10
SPARK_MASTER=local[*]
TRAINER_DRIVER_MEMORY=2g
TRAINER_MEM_LIMIT=3g
TRAINER_CPUS=4

# ---- Producer ----
PRODUCER_RATE=50
PRODUCER_LOOP=true
PRODUCER_LOG_INTERVAL_SECONDS=10

# ---- Stream processor (Spark Structured Streaming) ----
STREAM_DRIVER_MEMORY=1g
STREAM_MEM_LIMIT=2g
STREAM_CPUS=2
TRIGGER_INTERVAL_SECONDS=1
MAX_OFFSETS_PER_TRIGGER=5000
STARTING_OFFSETS=earliest
# Predictions older than this are deleted from PostgreSQL (dashboard totals cover this window)
PREDICTIONS_RETENTION_HOURS=6
# Leave empty to use the model's tuned threshold (max F1 on validation)
ALERT_THRESHOLD_OVERRIDE=
SPARK_UI_HOST_PORT=4040

# ---- Dashboard ----
DASHBOARD_HOST_PORT=8501
DASHBOARD_REFRESH_SECONDS=2
MANUAL_TEST_TIMEOUT_SECONDS=15
KAFKA_UI_HOST_PORT=8081

# ---- Container memory limits (sized for an 8-16 GB laptop) ----
KAFKA_MEM_LIMIT=1g
KAFKA_HEAP_OPTS=-Xms512m -Xmx512m
KAFKA_UI_MEM_LIMIT=512m
POSTGRES_MEM_LIMIT=256m
PRODUCER_MEM_LIMIT=256m
DASHBOARD_MEM_LIMIT=768m

# ---- Logging ----
LOG_LEVEL=INFO

digraph architecture {
  graph [rankdir=TB, bgcolor="white", nodesep=0.45, ranksep=0.65, pad=0.25, newrank=true, fontname="Helvetica"];
  node [fontname="Helvetica", margin="0.18,0.10", penwidth=1.6, color="#898781"];
  edge [fontname="Helvetica", fontsize=11, color="#898781", fontcolor="#898781", arrowsize=0.8, penwidth=1.4];
  csv [shape=cylinder, style=filled, fillcolor="#f3f2ef", color="#898781", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><FONT POINT-SIZE="16" COLOR="#0b0b0b"><B>creditcard.csv</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#52514e">Kaggle</FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#52514e">284,807 transactions</FONT></TD></TR></TABLE>>];
  prep [shape=box, style="rounded,filled", fillcolor="#e7f0fc", color="#2a78d6", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><FONT POINT-SIZE="16" COLOR="#0b0b0b"><B>Prepare data</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#52514e">dedup · group-aware</FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#52514e">stratified split 70/15/15</FONT></TD></TR></TABLE>>];
  train [shape=box, style="rounded,filled", fillcolor="#e7f0fc", color="#2a78d6", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><FONT POINT-SIZE="16" COLOR="#0b0b0b"><B>Train and select (Spark MLlib)</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#52514e">LR · RF · GBT · SVM</FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#52514e">× class weights / undersampling</FONT></TD></TR></TABLE>>];
  model [shape=cylinder, style=filled, fillcolor="#f3f2ef", color="#898781", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><FONT POINT-SIZE="16" COLOR="#0b0b0b"><B>Saved model</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#52514e">PipelineModel</FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#52514e">+ tuned threshold</FONT></TD></TR></TABLE>>];
  test [shape=cylinder, style=filled, fillcolor="#f3f2ef", color="#898781", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><FONT POINT-SIZE="16" COLOR="#0b0b0b"><B>Test split</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#52514e">held out, never trained on</FONT></TD></TR></TABLE>>];
  producer [shape=box, style="rounded,filled", fillcolor="#e2f5ee", color="#1baf7a", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><FONT POINT-SIZE="16" COLOR="#0b0b0b"><B>Producer</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#52514e">replays the test split</FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#52514e">50 tx/s</FONT></TD></TR></TABLE>>];
  tx [shape=box, style="rounded,filled", fillcolor="#fdeee6", color="#eb6834", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><FONT POINT-SIZE="16" COLOR="#0b0b0b"><B>transactions</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#52514e">Kafka topic · 3 partitions</FONT></TD></TR></TABLE>>];
  spark [shape=box, style="rounded,filled", fillcolor="#e2f5ee", color="#1baf7a", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><FONT POINT-SIZE="16" COLOR="#0b0b0b"><B>Spark Structured Streaming</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#52514e">parse → validate → score → label</FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#52514e">1 s micro-batches</FONT></TD></TR></TABLE>>];
  ctrl [shape=box, style="rounded,filled", fillcolor="#fdeee6", color="#eb6834", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><FONT POINT-SIZE="16" COLOR="#0b0b0b"><B>producer-control</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#52514e">Kafka topic · compacted</FONT></TD></TR></TABLE>>];
  pred [shape=box, style="rounded,filled", fillcolor="#fdeee6", color="#eb6834", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><FONT POINT-SIZE="16" COLOR="#0b0b0b"><B>predictions</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#52514e">Kafka topic · 3 partitions</FONT></TD></TR></TABLE>>];
  alert [shape=box, style="rounded,filled", fillcolor="#fdeee6", color="#eb6834", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><FONT POINT-SIZE="16" COLOR="#0b0b0b"><B>fraud-alerts</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#52514e">Kafka topic · 1 partition</FONT></TD></TR></TABLE>>];
  pg [shape=cylinder, style=filled, fillcolor="#f3f2ef", color="#898781", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><FONT POINT-SIZE="16" COLOR="#0b0b0b"><B>PostgreSQL</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#52514e">predictions · threshold</FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#52514e">stream progress</FONT></TD></TR></TABLE>>];
  kui [shape=box, style="rounded,filled", fillcolor="#fdf4dc", color="#c98500", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><FONT POINT-SIZE="16" COLOR="#0b0b0b"><B>Kafka UI</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#52514e">read-only</FONT></TD></TR></TABLE>>];
  dash [shape=box, style="rounded,filled", fillcolor="#fdf4dc", color="#c98500", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><FONT POINT-SIZE="16" COLOR="#0b0b0b"><B>Streamlit dashboard</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#52514e">English / العربية</FONT></TD></TR></TABLE>>];
  { rank=same; csv; prep; train; }
  csv -> prep [style=invis, weight=4];
  prep -> train [style=invis, weight=4];
  { rank=same; test; model; }
  test -> model [style=invis, weight=4];
  { rank=same; producer; tx; spark; }
  producer -> tx [style=invis, weight=4];
  tx -> spark [style=invis, weight=4];
  { rank=same; ctrl; pred; alert; pg; }
  ctrl -> pred [style=invis, weight=4];
  pred -> alert [style=invis, weight=4];
  alert -> pg [style=invis, weight=4];
  { rank=same; kui; dash; }
  kui -> dash [style=invis, weight=4];
  csv -> prep [];
  prep -> train [label="  train split  "];
  train -> model [label="  best model  "];
  prep -> test [label="  held out  "];
  test -> producer [];
  producer -> tx [label="  JSON  "];
  tx -> spark [];
  model -> spark [label="  loaded once  "];
  spark -> pred [label="  all rows  "];
  spark -> alert [label="  score ≥ threshold  "];
  spark -> pg [label="  upsert  "];
  pg -> dash [label="  SQL queries  "];
  dash -> pg [label="  threshold slider  ", style=dashed, constraint=false];
  pg -> spark [label="  threshold (each batch)  ", style=dashed, constraint=false];
  dash -> ctrl [label="  pause · resume · rate  ", style=dashed, constraint=false];
  ctrl -> producer [style=dashed, constraint=false];
  dash -> tx [label="  manual test  ", style=dashed, constraint=false];
  kui -> pred [label="  browse topics  ", style=dashed, constraint=false];
}
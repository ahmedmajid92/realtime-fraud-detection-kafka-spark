flowchart LR
    subgraph OFF["① Offline training · Spark MLlib (batch)"]
        direction TB
        CSV[("creditcard.csv<br/>Kaggle")]
        PREP["Dedup +<br/>stratified split<br/>70 / 15 / 15"]
        TRAIN["Compare LR · RF · GBT · SVM<br/>× class weights / undersampling<br/>select by validation AUC-PR"]
        MODEL[("best_model<br/>PipelineModel")]
        TEST[("test.parquet<br/>held-out split")]
        CSV --> PREP --> TRAIN --> MODEL
        PREP --> TEST
    end

    CTL["⑦ Dashboard controls<br/>sidebar · Test page"]
    PROD["② Producer<br/>replays test split<br/>50 tx/s"]

    subgraph KIN["③ Kafka · input topics"]
        direction TB
        CTRL[["producer-control<br/>(compacted)"]]
        TX[["transactions"]]
    end

    SPARK["④ Spark Structured Streaming<br/>1 s micro-batches<br/>parse → score → label"]

    subgraph KOUT["⑤ Kafka · output topics"]
        direction TB
        PRED[["predictions"]]
        ALERT[["fraud-alerts"]]
    end

    PG[("⑥ PostgreSQL<br/>predictions · settings")]
    DASH["⑦ Dashboard views<br/>English / Arabic"]
    KUI["Kafka UI<br/>(read-only)"]

    TEST --> PROD
    PROD -- "JSON" --> TX
    TX --> SPARK
    MODEL --> SPARK
    SPARK -- "all rows" --> PRED
    SPARK -- "p ≥ threshold" --> ALERT
    SPARK -- "upsert" --> PG
    PG --> DASH

    CTL -. "pause / resume / rate" .-> CTRL
    CTRL -.-> PROD
    CTL -. "manual test" .-> TX
    DASH -. "threshold slider" .-> PG
    PG -. "threshold per batch" .-> SPARK
    KOUT -.- KUI
